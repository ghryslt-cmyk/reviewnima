# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Admin Email (only this email can access admin panel)
VITE_ADMIN_EMAIL=your-admin-email@gmail.com

# Donation / rank system (Trakteer + Cloudflare Worker)
# Trakteer tip page that donors are redirected to.
VITE_TRAKTEER_URL=https://trakteer.id/your-username/tip
# Base URL of the deployed Cloudflare Worker (no trailing slash).
VITE_DONATION_WORKER_URL=https://nimarank-worker.your-subdomain.workers.dev
# Minimum donation (IDR) required for each rank. HARUS sama dengan harga unit
# di Trakteer (unit "DONATUR" = 5000, unit "DONATUR++" = 10000) dan dengan
# worker/wrangler.toml.
VITE_DONATUR_MIN=5000
VITE_DONATUR_PLUS_MIN=10000

# MAL API Client ID (for fetching anime schedule)
MAL_CLIENT_ID=your-mal-client-id
