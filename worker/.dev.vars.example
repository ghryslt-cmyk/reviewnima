# Salin file ini menjadi `.dev.vars` untuk testing lokal dengan `npm run dev`.
# File `.dev.vars` sudah masuk .gitignore, jangan pernah di-commit.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...isi private_key dari JSON service account...\n-----END PRIVATE KEY-----\n"
TRAKTEER_WEBHOOK_TOKEN=ganti-dengan-string-acak
DONATUR_MIN=5000
DONATUR_PLUS_MIN=10000
