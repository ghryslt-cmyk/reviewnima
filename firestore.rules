rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Visitor count - allow read for everyone, write for admin
    match /stats/visitors {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ghryslt@gmail.com';
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ghryslt@gmail.com';
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.token.email == resource.data.authorEmail;
        
        match /replies/{replyId} {
          allow read: if true;
          allow create: if request.auth != null;
          allow update, delete: if request.auth != null && request.auth.token.email == resource.data.authorEmail;
        }
      }
    }
    
    // Anime collection
    match /anime/{animeId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.email == 'ghryslt@gmail.com';
      
      // Episodes subcollection
      match /episodes/{episodeId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.token.email == 'ghryslt@gmail.com';
      }
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.token.email == resource.data.authorEmail;
        
        match /replies/{replyId} {
          allow read: if true;
          allow create: if request.auth != null;
          allow update, delete: if request.auth != null && request.auth.token.email == resource.data.authorEmail;
        }
      }
    }
    
    // Reports collection
    match /reports/{reportId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email == 'ghryslt@gmail.com';
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'ghryslt@gmail.com');
      allow create: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'ghryslt@gmail.com');
      allow update: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'ghryslt@gmail.com');
    }
  }
}
